{
  "latex-workshop.latex.autoBuild.run": "onSave", // "never"
  "latex-workshop.formatting.latex": "tex-fmt",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-lualatex",
        "-bibtex",
        "-outdir=%OUTDIR%",
        "%DOCFILE%"
      ],
      "env": {}
    },
    {
      "name": "copy pdf date",
      "command": "sh",
      "args": [
        "-c",
        "cp \"%PDF%\" \"$(dirname \"%PDF%\")/wolfram-mathematica-$(date +%Y-%m-%d).pdf\""
      ],
      "env": {}
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": [
        "latexmk"
      ]
    },
    {
      "name": "latexmk ➞ copy pdf date",
      "tools": [
        "latexmk",
        "copy pdf date"
      ]
    }
  ],
  "latex-workshop.hover.preview.enabled": false,
  "latex-workshop.message.warning.show": false,
  "latex-workshop.message.badbox.show": "none",
  "latex-workshop.message.error.show": true,
  "files.exclude": {
    "**/*.aux": true,
    "**/*.fdb_latexmk": true,
    "**/*.fls": true,
    "**/*.log": true,
    "**/*.out": true,
    "**/*.synctex.gz": true,
    "**/*.toc": true,
    "**/*.bcf": true,
    "**/*.run.xml": true
  },
  "search.exclude": {
    "**/*.aux": true,
    "**/*.log": true
  }
}